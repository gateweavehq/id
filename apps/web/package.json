{
	"name": "@gateweave/id-web",
	"version": "0.0.0",
	"private": true,
	"license": "AGPL-3.0-only",
	"type": "module",
	"scripts": {
		"dev": "vite dev --port 4730 --strictPort",
		"dev:setup": "node scripts/dev-setup.mjs",
		"build": "vite build",
		"preview": "vite preview --port 4731 --strictPort",
		"deploy": "node scripts/deploy.mjs",
		"deploy:staging": "vite build --mode staging && wrangler deploy --cwd ../..",
		"typegen": "wrangler types && tsr generate",
		"typecheck": "wrangler types && tsr generate && tsc && tsc -p scripts && tsc -p test && tsc -p e2e",
		"test": "vitest run",
		"test:e2e": "node e2e/build.mjs && playwright test",
		"test:conformance": "node conformance/run.mjs",
		"apps:add": "node scripts/add-app.ts",
		"two-factor:remove": "node scripts/remove-two-factor.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply DB --local --persist-to .wrangler/state",
		"db:migrate:remote": "wrangler d1 migrations apply DB --remote",
		"db:migrate:staging": "wrangler d1 migrations apply DB --remote --env staging",
		"auth:schema": "pnpm dlx auth@1.7.16 generate --config src/server/auth/cli.ts --output src/server/db/auth-schema.ts --yes"
	},
	"dependencies": {
		"@better-auth/oauth-provider": "1.7.16",
		"@better-auth/passkey": "1.7.16",
		"@fontsource-variable/inter": "5.3.0",
		"@simplewebauthn/browser": "13.3.0",
		"@tanstack/react-router": "1.170.46",
		"@tanstack/react-start": "1.169.4",
		"better-auth": "1.7.16",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"drizzle-orm": "catalog:",
		"radix-ui": "1.8.1",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"sonner": "2.0.8",
		"tailwind-merge": "3.7.0",
		"uqr": "0.1.3",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.66.0",
		"@playwright/test": "1.64.1",
		"@tailwindcss/vite": "4.3.3",
		"@tanstack/devtools-vite": "0.8.6",
		"@tanstack/react-devtools": "0.10.14",
		"@tanstack/react-router-devtools": "1.167.2",
		"@tanstack/router-cli": "1.167.46",
		"@types/node": "26.6.6",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.2",
		"drizzle-kit": "catalog:",
		"miniflare": "5.20261023.0-beta",
		"oauth4webapi": "3.8.8",
		"tailwindcss": "4.3.3",
		"tw-animate-css": "1.4.0",
		"typescript": "catalog:",
		"vite": "8.3.5",
		"vitest": "catalog:",
		"wrangler": "catalog:"
	}
}
