# Copied to .dev.vars by `pnpm dev:setup`, which also fills in a random secret.
# The "Deploy to Cloudflare" button asks for every key set here, so the optional ones stay
# commented out. Uncomment one to use it.

# Signs sessions. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Optional: enables "Sign in with GitHub". Callback URL: http://localhost:4730/api/auth/callback/github
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Optional: puts Cloudflare Turnstile in front of sending email and password sign-in. Set both, or it
# stays off. Cloudflare's test keys work locally: see developers.cloudflare.com/turnstile/troubleshooting/testing/
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Optional: "1" refuses passwords known from breaches. It sends the first five characters of a
# password's SHA-1 to Have I Been Pwned, which never learns the password.
# CHECK_BREACHED_PASSWORDS=

# Optional: keeps the rate limits' Durable Objects in a jurisdiction, such as eu. Local dev has
# no jurisdictions, so leave it out here.
# DURABLE_OBJECT_JURISDICTION=

# Optional: pins the app's URL. Leave it out to accept any host, for example from your phone. The
# OIDC provider needs it, because its origin is the issuer, and so do passkeys. Each passkey is bound
# to this host for good: move to another and everyone's stop working.
# BETTER_AUTH_URL=

# Optional: with BETTER_AUTH_URL, turns on the OIDC provider. It gives each app its own id for each
# person. Generate with: openssl rand -base64 32. Never change it once an app has signed anyone in.
# OIDC_PAIRWISE_SECRET=

# Optional: turns on email, such as "Gateweave ID <id@example.com>". Sign-up codes and password reset
# need it: without email, GitHub is the only way to an account. `pnpm dev:setup` turns it on locally,
# where nothing is sent: each email is saved under apps/web/.wrangler/tmp/email, and its path is
# printed in the terminal.
# EMAIL_FROM=

# Optional: the addresses of your legal pages, linked from the sign-in pages, the page that asks to
# allow an app, and the account and workspace pages. Nothing is linked when they are unset.
# LEGAL_NOTICE_URL=
# PRIVACY_POLICY_URL=
# TERMS_URL=

# Optional: an https address where people can ask for an account while sign-up is closed. The sign-up
# and sign-in pages then show "Ask for access" linking to it.
# SIGN_UP_REQUEST_URL=

# Optional. Seconds before a back-channel logout an app missed is first tried again (default 60).
# LOGOUT_RETRY_SECONDS=
